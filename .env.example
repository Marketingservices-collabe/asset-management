# Copy to .env and fill in.

# PostgreSQL connection strings.
# Local dev: both can point at the same local DB.
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asset_tracker"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/asset_tracker"
# Supabase (production): DATABASE_URL = pooled "Transaction" connection (port 6543, ?pgbouncer=true),
# DIRECT_URL = direct connection (port 5432, no pgbouncer) — used only for migrations.
# Both are on the project's Settings → Database page.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asset_tracker"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/asset_tracker"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Google OAuth (optional; leave blank to use email/password only)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Shared secret for /api/cron/* endpoints
CRON_SECRET="replace-me"

# Seed admin (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@zentrades.pro"
SEED_ADMIN_PASSWORD="changeme123"
