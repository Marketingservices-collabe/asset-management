# Copy to .env and fill in.

# PostgreSQL connection string.
# Local: postgresql://postgres:postgres@localhost:5432/asset_tracker
# Or a free hosted DB (Neon): postgresql://USER:PASS@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asset_tracker"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Google OAuth (optional; leave blank to use email/password only)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Shared secret for /api/cron/* endpoints
CRON_SECRET="replace-me"

# Seed admin (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@zentrades.pro"
SEED_ADMIN_PASSWORD="changeme123"
